<ui:FluentWindow x:Class="WpfUiTrial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="BFR – WPF-UI trial" Width="1100" Height="680"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Batch File Renamer">
            <ui:TitleBar.Icon><ui:ImageIcon /></ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Thêm tệp" />
            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Folder24}" Content="Thêm thư mục" />
            <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Library24}" Content="Khay tệp" />
            <ToggleButton Margin="16,0,0,0" Content="Quét thư mục con" />
            <ui:Button x:Name="ThemeBtn" Margin="16,0,0,0" Icon="{ui:SymbolIcon WeatherMoon24}"
                       Content="Đổi giao diện" Click="Theme_Click" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Quy tắc" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Tìm và thay thế" FontWeight="SemiBold" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="Tìm" />
                        <ui:TextBox Margin="0,8,0,0" PlaceholderText="Thay bằng" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Đánh số" FontWeight="SemiBold" />
                        <ui:NumberBox Margin="0,8,0,0" Value="1" />
                    </StackPanel>
                </ui:Card>
                <ui:Button Icon="{ui:SymbolIcon Add24}" Content="Thêm quy tắc" HorizontalAlignment="Stretch" />
            </StackPanel>

            <DockPanel Grid.Column="2">
                <ui:InfoBar DockPanel.Dock="Top" IsOpen="True" Severity="Informational" IsClosable="False"
                            Title="Xem trước" Message="12 tệp sẽ đổi tên, 0 xung đột." Margin="0,0,0,8" />
                <ui:DataGrid x:Name="Grid" AutoGenerateColumns="True" IsReadOnly="True" />
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Icon="{ui:SymbolIcon ArrowUndo24}" Content="Hoàn tác" />
            <ui:Button Appearance="Primary" Margin="8,0,0,0" Icon="{ui:SymbolIcon Checkmark24}" Content="Áp dụng" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
