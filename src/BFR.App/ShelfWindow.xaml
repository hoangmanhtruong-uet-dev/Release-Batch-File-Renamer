<ui:FluentWindow x:Class="BFR.App.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Shelf" Width="320" Height="420" MinWidth="260" MinHeight="260"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowStartupLocation="Manual"
        AllowDrop="True" DragOver="Shelf_DragOver" Drop="Shelf_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}" ShowMinimize="False" ShowMaximize="False" />
    <Grid Grid.Row="1" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="CountText" Grid.Row="0" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextSecondary}" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                Background="{DynamicResource SurfaceBackground}" CornerRadius="6">
            <Grid>
                <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent"
                         KeyDown="ItemList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name, Mode=OneTime}" ToolTip="{Binding FullPath, Mode=OneTime}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}" Margin="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                           Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button x:Name="ClearButton" Appearance="Secondary"
                    Padding="12,6" Click="Clear_Click" />
            <ui:Button x:Name="RenameButton" Appearance="Primary"
                    Padding="14,6" Margin="8,0,0,0" Click="Rename_Click" />
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
