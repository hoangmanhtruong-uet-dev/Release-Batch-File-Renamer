<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Token màu — bản tối ============ -->
    <!-- Giữ đúng tên token với bản sáng để ThemeManager hoán đổi liền mạch. -->

    <Color x:Key="ColorAccent">#FF60CDFF</Color>
    <SolidColorBrush x:Key="AppBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="PanelBackground" Color="#FF272727" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#FF383838" />
    <SolidColorBrush x:Key="SurfaceSelected" Color="#FF1F3B57" />
    <SolidColorBrush x:Key="CardBackground" Color="#FF2D2D2D" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFBDBDBD" />
    <SolidColorBrush x:Key="TextDisabled" Color="#FF7A7A7A" />
    <SolidColorBrush x:Key="TextOnAccent" Color="#FF101010" />

    <SolidColorBrush x:Key="Accent" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF7AD4FF" />
    <SolidColorBrush x:Key="AccentPressed" Color="#FF4FB6E8" />
    <SolidColorBrush x:Key="AccentSoft" Color="#FF1F3B57" />
    <SolidColorBrush x:Key="AccentBorder" Color="#FF2F5C80" />

    <SolidColorBrush x:Key="Border" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="BorderStrong" Color="#FF4C4C4C" />
    <SolidColorBrush x:Key="Divider" Color="#FF323232" />

    <SolidColorBrush x:Key="Success" Color="#FF6CCB5F" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#FF17331A" />
    <SolidColorBrush x:Key="Warning" Color="#FFF2C661" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FF3A2E12" />
    <SolidColorBrush x:Key="Error" Color="#FFF1707B" />
    <SolidColorBrush x:Key="ErrorSoft" Color="#FF3B1B1E" />
    <SolidColorBrush x:Key="Info" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="InfoSoft" Color="#FF1F3B57" />

    <SolidColorBrush x:Key="DiffAdded" Color="#FF1E4A2C" />
    <SolidColorBrush x:Key="DiffRemoved" Color="#FF4A2124" />
    <SolidColorBrush x:Key="DiffAddedText" Color="#FF9BE7B4" />
    <SolidColorBrush x:Key="DiffRemovedText" Color="#FFFFB3B8" />

    <SolidColorBrush x:Key="ChipBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ChipBorder" Color="#FF454545" />
    <SolidColorBrush x:Key="ChipSelectedBackground" Color="#FF1F3B57" />
    <SolidColorBrush x:Key="ChipSelectedBorder" Color="#FF60CDFF" />
</ResourceDictionary>
