<Window x:Class="BFR.App.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource HistoryTitle}" Height="500" Width="920"
        MinHeight="360" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        UseLayoutRounding="True"
        AutomationProperties.Name="History and Undo Window">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0" Margin="2,0,2,10">
            <TextBlock Text="{DynamicResource HistoryTitle}" FontSize="{StaticResource AppFontSizeTitle}"
                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="{DynamicResource HistoryHint}" Style="{StaticResource CaptionTextStyle}"
                       Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Bảng + trạng thái rỗng -->
        <Grid Grid.Row="1">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      Style="{StaticResource PreviewDataGridStyle}"
                      AutomationProperties.Name="Rename Runs History Table">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Id}" Width="90" Header="{DynamicResource HistoryColId}" />
                    <DataGridTextColumn Binding="{Binding StartedUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" Header="{DynamicResource HistoryColTime}" />
                    <DataGridTextColumn Binding="{Binding Total}" Width="70" Header="{DynamicResource HistoryColTotal}" />
                    <DataGridTextColumn Binding="{Binding Succeeded}" Width="70" Header="{DynamicResource HistoryColOk}" />
                    <DataGridTextColumn Binding="{Binding Failed}" Width="70" Header="{DynamicResource HistoryColFailed}" />
                    <DataGridTextColumn Binding="{Binding Status}" Width="110" Header="{DynamicResource HistoryColStatus}" />
                    <DataGridTextColumn Binding="{Binding Preset}" Width="*" Header="{DynamicResource HistoryColPreset}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{DynamicResource HistoryEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                       Foreground="{DynamicResource TextSecondary}"
                       Visibility="{Binding HistoryGrid.ItemsSource.Count, Converter={StaticResource ZeroToVis}, RelativeSource={RelativeSource AncestorType=Window}}"
                       AutomationProperties.Name="History Empty" />
        </Grid>

        <!-- Thanh hành động -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <Button Content="{DynamicResource RefreshHistory}" Click="Refresh_Click"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    AutomationProperties.Name="Refresh History List" />
            <Button Content="{DynamicResource UndoSelected}" Click="Undo_Click"
                    Style="{StaticResource PrimaryButtonStyle}" FontWeight="SemiBold"
                    AutomationProperties.Name="Undo Selected Run" />
            <Button Content="{DynamicResource CloseDialog}" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                    AutomationProperties.Name="Close History Window" />
        </DockPanel>
    </Grid>
</Window>
