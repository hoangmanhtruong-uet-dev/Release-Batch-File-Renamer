<Window x:Class="BFR.App.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource RuleEditorTitle}" Height="600" Width="860"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable, Segoe UI"
        AutomationProperties.Name="Rule Editor Window">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ComboBox x:Name="NewTypeCombo" Width="180" AutomationProperties.Name="Rule Type Selection" />
            <Button Content="{DynamicResource AddRule}" Click="Add_Click" Margin="8,0,0,0" Padding="10,4"
                    AutomationProperties.Name="Add New Rule" />
            <Button Content="{DynamicResource DeleteRule}" Click="Delete_Click" Margin="8,0,0,0" Padding="10,4"
                    AutomationProperties.Name="Delete Selected Rule" />
            <Button Content="{DynamicResource MoveUp}" Click="Up_Click" Margin="8,0,0,0" Padding="10,4"
                    AutomationProperties.Name="Move Rule Up" />
            <Button Content="{DynamicResource MoveDown}" Click="Down_Click" Margin="8,0,0,0" Padding="10,4"
                    AutomationProperties.Name="Move Rule Down" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="RuleList" Grid.Column="0" DisplayMemberPath="Display"
                     SelectionChanged="RuleList_SelectionChanged" Margin="0,0,10,0"
                     AutomationProperties.Name="Rules Sequence List" />

            <Border Grid.Column="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel" AutomationProperties.Name="Rule Configuration Panel" />
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="{DynamicResource CancelRule}" Click="Cancel_Click" Padding="16,6" Margin="0,0,8,0"
                    IsCancel="True" AutomationProperties.Name="Cancel and Close" />
            <Button Content="{DynamicResource SaveRule}" Click="Save_Click" Padding="16,6" FontWeight="SemiBold"
                    IsDefault="True" AutomationProperties.Name="Save Rules" />
        </DockPanel>
    </Grid>
</Window>
