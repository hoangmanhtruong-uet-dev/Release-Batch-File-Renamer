<Window x:Class="BFR.App.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command palette"
        Width="620" SizeToContent="Height" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Command palette dialog">

    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Ô tìm kiếm -->
            <Grid Grid.Row="0" Margin="18,16,18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />

                <TextBox x:Name="InputBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}"
                         AutomationProperties.Name="Command palette search" />
            </Grid>

            <!-- Danh sách lệnh -->
            <Grid Grid.Row="1" Margin="10,0,10,0">
                <ListBox MaxHeight="400"
                         ItemsSource="{Binding Filtered}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         HorizontalContentAlignment="Stretch"
                         Style="{StaticResource AppListBoxStyle}"
                         AutomationProperties.Name="Command palette results">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Category}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextTertiary}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Shortcut}" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,24,0,24"
                           Foreground="{DynamicResource TextSecondary}"
                           Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVis}}" />
            </Grid>

            <!-- Chân -->
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="18,8" CornerRadius="0,0,11,11"
                    Background="{DynamicResource SurfaceSecondary}">
                <TextBlock Text="{Binding HintText}" Foreground="{DynamicResource TextTertiary}" />
            </Border>
        </Grid>
    </Border>
</Window>
