<Window x:Class="BFR.App.UpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BFR.App"
        Title="{Binding Header}"
        Width="640" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Upgrade to Pro dialog">

    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="22,18,14,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Header}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        Click="Close_Click" VerticalAlignment="Top" Margin="8,0,0,0"
                        AutomationProperties.Name="Close upgrade dialog" />
            </Grid>

            <!-- ===== Dòng bối cảnh (tính năng đang chạm tới Pro) ===== -->
            <Border Grid.Row="1" Margin="22,14,22,0" CornerRadius="8" Padding="12,9"
                    Background="{DynamicResource AccentSoft}"
                    BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                    Visibility="{Binding HasContext, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ContextMessage}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ===== Bảng so sánh Free vs Pro ===== -->
            <Grid Grid.Row="2" Margin="22,16,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FreeColumnHeader}" HorizontalAlignment="Center"
                           Style="{StaticResource PanelHeaderTextStyle}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProColumnHeader}" HorizontalAlignment="Center"
                           Style="{StaticResource PanelHeaderTextStyle}" Margin="0,0,0,6" />

                <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding Features}"
                              AutomationProperties.Name="Feature comparison Free and Pro">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Feature}" Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding FreeText}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ProText}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ===== Hành động ===== -->
            <StackPanel Grid.Row="3" Margin="22,20,22,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{Binding BuyButtonText}" Click="Buy_Click" MinWidth="150"
                            AutomationProperties.Name="Buy Pro" />

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                            Content="{Binding TrialButtonText}" Click="Trial_Click" MinWidth="150" Margin="10,0,0,0"
                            Visibility="{Binding ShowTrialButton, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Start Pro trial" />

                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}"
                            Content="{Binding LaterButtonText}" Click="Close_Click" HorizontalAlignment="Right"
                            AutomationProperties.Name="Close" />
                </Grid>

                <!-- Dùng thử: còn X ngày -->
                <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,9"
                        Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}"
                        BorderThickness="1"
                        Visibility="{Binding ShowTrialRemaining, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding TrialRemainingText}" Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Nhập mã kích hoạt -->
                <StackPanel Margin="0,12,0,0">
                    <Button Style="{StaticResource SubtleButtonStyle}" Content="{Binding LicenseKeyLinkText}"
                            HorizontalAlignment="Left" Padding="0,2" Click="ShowLicenseKey_Click"
                            AutomationProperties.Name="I already have an activation key" />

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding IsLicenseKeyVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding LicenseKeyText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     ToolTip="{Binding LicenseKeyPlaceholder}"
                                     AutomationProperties.Name="Activation key" KeyDown="LicenseKey_KeyDown" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding ActivateKeyText}" Click="ActivateKey_Click" Margin="8,0,0,0"
                                    AutomationProperties.Name="Activate with key" />
                        </Grid>
                        <TextBlock Text="{Binding LicenseKeyError}" Foreground="{DynamicResource Error}"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasLicenseKeyError, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.Name="Activation error" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
