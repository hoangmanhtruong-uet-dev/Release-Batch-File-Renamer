<Window x:Class="BFR.App.RegexTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Regex tester"
        Width="780" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        UseLayoutRounding="True"
        AutomationProperties.Name="Regex tester dialog">

    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="22,18,14,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />

                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        Click="Close_Click" VerticalAlignment="Top" Margin="8,0,0,0"
                        AutomationProperties.Name="Close regex tester" />
            </Grid>

            <!-- ===== Ô nhập ===== -->
            <Grid Grid.Row="1" Margin="22,16,22,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PatternLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,10,8" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="Regex pattern" />
                <CheckBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,8" VerticalAlignment="Center"
                          Content="{Binding IgnoreCaseLabel}" IsChecked="{Binding IgnoreCase}"
                          Style="{StaticResource AppCheckBoxStyle}" AutomationProperties.Name="Ignore case" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ReplacementLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="Regex replacement" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding InputLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}" Margin="0,0,10,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,10,0" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource AppTextBoxStyle}" AutomationProperties.Name="Regex test string" />
                <Button Grid.Row="2" Grid.Column="2" Content="{Binding UseSelectedLabel}"
                        Style="{StaticResource SecondaryButtonStyle}" Click="UseSelected_Click"
                        AutomationProperties.Name="Use selected name" />
            </Grid>

            <!-- ===== Kết quả ===== -->
            <Border Grid.Row="2" Margin="22,14,22,0" CornerRadius="8" Padding="12,10"
                    Background="{DynamicResource SurfaceSecondary}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Danger}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding ResultLabel}" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding Output, Mode=OneWay}" Margin="0,4,0,0" MinHeight="34"
                             IsReadOnly="True" Style="{StaticResource AppTextBoxStyle}"
                             FontFamily="{StaticResource AppFontMono}" />

                    <ItemsControl ItemsSource="{Binding Matches}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}"
                                               FontFamily="{StaticResource AppFontMono}" Margin="0,0,12,0" />
                                    <ItemsControl ItemsSource="{Binding Groups}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">
                                                    <Run Text="[" />
                                                    <Run Text="{Binding Index, Mode=OneWay}" />
                                                    <Run Text="]: " />
                                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                                    <Run Text="]" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== Chân dialog ===== -->
            <Grid Grid.Row="3" Margin="22,16,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{Binding ApplyAllLabel}" Style="{StaticResource PrimaryButtonStyle}"
                        Click="ApplyAll_Click" AutomationProperties.Name="Apply regex to all files" />

                <ComboBox Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center" Width="240"
                          ItemsSource="{Binding Samples}"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedSampleName, Mode=TwoWay}"
                          Style="{StaticResource AppComboBoxStyle}"
                          AutomationProperties.Name="Regex sample library">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="{Binding HintText}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiary}" />
            </Grid>
        </Grid>
    </Border>
</Window>
