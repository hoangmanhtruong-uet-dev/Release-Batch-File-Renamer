<Window x:Class="BFR.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BFR.App"
        xmlns:conv="clr-namespace:BFR.App.Converters"
        Title="{DynamicResource WindowTitle}" Height="780" Width="1340"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource AppFontSizeBody}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        AutomationProperties.Name="Batch File Renamer Main Window">

    <Window.Resources>


        <!-- ================= Thẻ quy tắc (Rule Builder) ================= -->
        <DataTemplate x:Key="RuleCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="10"
                    AllowDrop="True" DragOver="RuleCard_DragOver" Drop="RuleCard_Drop">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="&#xE700;" FontFamily="{StaticResource IconFont}"
                                   FontSize="14" Foreground="{DynamicResource TextDisabled}"
                                   VerticalAlignment="Center" Cursor="SizeAll" Background="Transparent"
                                   MouseLeftButtonDown="RuleDragStart_Click"
                                   ToolTip="{DynamicResource RuleDragHint}"
                                   AutomationProperties.Name="{DynamicResource RuleDragHandleA11y}" />

                        <CheckBox Grid.Column="1" Margin="8,0,0,0" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Style="{StaticResource AppCheckBoxStyle}"
                                  AutomationProperties.Name="{DynamicResource RuleToggleA11y}" />

                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE946;"
                                Click="RuleRegexTester_Click" Tag="{Binding}" Margin="0,0,2,0"
                                ToolTip="{DynamicResource RegexTesterOpen}"
                                Visibility="{Binding CanOpenRegexTester, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Open regex tester" />

                        <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}" Content="&#xE70E;"
                                Command="{Binding MoveUpCommand}" Margin="0,0,2,0"
                                ToolTip="{DynamicResource RuleMoveUp}"
                                AutomationProperties.Name="Move rule up" />

                        <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}" Content="&#xE70D;"
                                Command="{Binding MoveDownCommand}" Margin="0,0,2,0"
                                ToolTip="{DynamicResource RuleMoveDown}"
                                AutomationProperties.Name="Move rule down" />

                        <Button Grid.Column="6" Style="{StaticResource IconButtonStyle}" Content="&#xE70F;"
                                Click="RuleToggleExpand_Click" Tag="{Binding}"
                                AutomationProperties.Name="{DynamicResource RuleEditHint}" />

                        <Button Grid.Column="7" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                                Click="RuleDelete_Click" Tag="{Binding}"
                                AutomationProperties.Name="{DynamicResource RuleDelete}" />
                    </Grid>

                    <!-- Bảng tham số mở rộng tại chỗ (accordion) -->
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="34,10,0,0"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                              Style="{StaticResource AppCheckBoxStyle}"
                                              Visibility="{Binding Kind, Converter={StaticResource ParameterKindToVis}, ConverterParameter=Toggle}" />
                                    <TextBox Grid.Column="1" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             Visibility="{Binding Kind, Converter={StaticResource ParameterKindToTextVis}, ConverterParameter=Text}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                              Style="{StaticResource AppComboBoxStyle}"
                                              Visibility="{Binding Kind, Converter={StaticResource ParameterKindToChoiceVis}, ConverterParameter=Choice}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ================= Cột tên có diff màu ================= -->
        <DataTemplate x:Key="OldNameTemplate">
            <ItemsControl ItemsSource="{Binding OldSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Highlight}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DiffRemoved}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedText}" />
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="NewNameTemplate">
            <ItemsControl ItemsSource="{Binding NewSegments}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextDecorations" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Highlight}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DiffAdded}" />
                                            <Setter Property="Foreground" Value="{DynamicResource DiffAddedText}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Hàng tiêu đề ứng dụng ================= -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8C5;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource AppTagline}" Margin="8,0,0,0" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TierBadge" Style="{StaticResource SubtleButtonStyle}"
                            Click="TierBadge_Click" Padding="10,4" Margin="0,0,10,0"
                            Background="{DynamicResource AccentSoft}"
                            BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                            AutomationProperties.Name="License tier">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="TierBadgeText" Text="Free" FontWeight="SemiBold" FontSize="11.5"
                                   Foreground="{DynamicResource Accent}" />
                    </Button>

                    <Button x:Name="SettingsButton" Style="{StaticResource SubtleButtonStyle}"
                            Content="{DynamicResource SettingsButton}" Click="Settings_Click"
                            AutomationProperties.Name="Open settings" />

                    <Button x:Name="UpgradeButton" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Upgrade}" Click="Upgrade_Click" Margin="6,0,0,0"
                            AutomationProperties.Name="Upgrade to Pro" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Thanh lệnh (CommandBar, 1 hàng) ================= -->
        <Grid Grid.Row="1" Margin="14,10,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddFiles_Click" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource AddFilesButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButtonStyle}" Click="AddFolder_Click" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource AddFolderButton}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{DynamicResource RecursiveChip}"
                              IsChecked="{Binding IsRecursive, Mode=TwoWay}" Margin="12,0,0,0"
                              AutomationProperties.Name="Include subfolders" />
                <ToggleButton Style="{StaticResource ChipToggleStyle}" Content="{DynamicResource IncludeFoldersChip}"
                              IsChecked="{Binding IncludeFolders, Mode=TwoWay}"
                              AutomationProperties.Name="Include folders" />

                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource SortByLabel}" VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0" />
                    <ComboBox x:Name="SortCombo" Width="170" SelectionChanged="SortCombo_SelectionChanged"
                              Style="{StaticResource AppComboBoxStyle}"
                              AutomationProperties.Name="Sort order">
                        <ComboBoxItem Content="{DynamicResource SortNameNatural}" Tag="NameNatural" />
                        <ComboBoxItem Content="{DynamicResource SortName}" Tag="NameOrdinal" />
                        <ComboBoxItem Content="{DynamicResource SortCreated}" Tag="Created" />
                        <ComboBoxItem Content="{DynamicResource SortModified}" Tag="Modified" />
                        <ComboBoxItem Content="{DynamicResource SortSize}" Tag="Size" />
                        <ComboBoxItem Content="{DynamicResource SortLoadOrder}" Tag="LoadOrder" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButtonStyle}" Click="ClearList_Click"
                        AutomationProperties.Name="Clear list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        <TextBlock Text="{DynamicResource ClearListButton}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource SecondaryButtonStyle}" Click="MoreMenu_Click" Margin="6,0,0,0"
                        AutomationProperties.Name="More actions">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        <TextBlock Text="{DynamicResource MoreMenu}" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Vùng làm việc: Rule Builder | Preview ================= -->
        <Grid Grid.Row="2" Margin="14,4,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="480" />
            </Grid.ColumnDefinitions>

            <!-- Trái: Rule Builder -->
            <DockPanel Grid.Column="0" Background="{DynamicResource PanelBackground}" Margin="0,0,0,0">
                <Grid DockPanel.Dock="Top" Margin="12,10,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource RuleBuilderHeader}" Style="{StaticResource PanelHeaderTextStyle}" />
                        <ComboBox x:Name="PresetCombo" Margin="0,6,0,0"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  SelectionChanged="PresetCombo_SelectionChanged"
                                  AutomationProperties.Name="Preset selection">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                            Click="PresetMenu_Click" VerticalAlignment="Top"
                            AutomationProperties.Name="Preset menu" />
                </Grid>

                <DockPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="SavePreset_Click" Margin="0,0,6,0"
                            AutomationProperties.Name="Save as preset button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            <TextBlock Text="{DynamicResource SaveAsPresetButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="AddRule_Click"
                            AutomationProperties.Name="Add rule button">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                            <TextBlock Text="{DynamicResource AddRuleButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Grid DockPanel.Dock="Top" Margin="12,0">
                    <TextBlock Text="{DynamicResource RulesEmpty}" Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Rules.Count, Converter={StaticResource ZeroToVis}}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,8,0">
                    <ItemsControl x:Name="RulesItems" ItemsSource="{Binding Rules}"
                                  ItemTemplate="{StaticResource RuleCardTemplate}" />
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          AutomationProperties.Name="Resize rule panel" />

            <!-- Phải: bảng xem trước -->
            <Grid Grid.Column="2" Background="{DynamicResource PanelBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="PreviewGrid" Grid.Row="0" Style="{StaticResource PreviewDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource PreviewHeaderStyle}"
                          RowStyle="{StaticResource PreviewRowStyle}"
                          CellStyle="{StaticResource PreviewCellStyle}"
                          ItemsSource="{Binding FilteredRows}"
                          SelectionChanged="PreviewGrid_SelectionChanged"
                          AutomationProperties.Name="Preview table">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource ColSelect}" Width="52">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"
                                              Focusable="False" Style="{StaticResource AppCheckBoxStyle}"
                                              AutomationProperties.Name="Include file in rename" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{DynamicResource ColOld}" Width="*"
                                                CellTemplate="{StaticResource OldNameTemplate}" />

                        <DataGridTemplateColumn Header="{DynamicResource ColNew}" Width="*"
                                                CellTemplate="{StaticResource NewNameTemplate}" />

                        <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusIcon}" FontFamily="{StaticResource IconFont}"
                                                   FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InvalidName">
                                                            <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="PathTooLong">
                                                            <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ok">
                                                            <Setter Property="Foreground" Value="{DynamicResource Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Conflict">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="InvalidName">
                                                            <Setter Property="Foreground" Value="{DynamicResource Error}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{DynamicResource ColFolder}" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FolderText}" TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource CaptionTextStyle}"
                                               ToolTip="{Binding FolderText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Hàng lọc + tìm kiếm -->
                <Grid Grid.Row="1" Margin="12,8,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource AppRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterAll}"
                                     IsChecked="True" Checked="Filter_Checked" Tag="All" Margin="0,0,6,0"
                                     AutomationProperties.Name="Filter all" />
                        <RadioButton x:Name="FilterWillChange" Style="{StaticResource AppRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterWillChange}"
                                     Checked="Filter_Checked" Tag="WillChange" Margin="0,0,6,0"
                                     AutomationProperties.Name="Filter will change" />
                        <RadioButton x:Name="FilterUnchanged" Style="{StaticResource AppRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterUnchanged}"
                                     Checked="Filter_Checked" Tag="Unchanged" Margin="0,0,6,0"
                                     AutomationProperties.Name="Filter unchanged" />
                        <RadioButton x:Name="FilterProblems" Style="{StaticResource AppRadioButtonStyle}" GroupName="PreviewFilter" Content="{DynamicResource FilterProblems}"
                                     Checked="Filter_Checked" Tag="Problems" Margin="0,0,12,0"
                                     AutomationProperties.Name="Filter problems" />
                    </StackPanel>

                    <TextBox x:Name="PreviewSearchBox" Grid.Column="1" Width="220"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AppTextBoxStyle}"
                             AutomationProperties.Name="Search files" />
                </Grid>

                <!-- Ngăn Rule Trace (timeline) -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="12,8">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TraceHeader}" Style="{StaticResource PanelHeaderTextStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{DynamicResource TraceEmpty}" Style="{StaticResource CaptionTextStyle}"
                                   Visibility="{Binding SelectedRow, Converter={StaticResource NullToVis}}" />
                        <ItemsControl ItemsSource="{Binding TraceSteps}"
                                      Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#xE16A;" FontSize="10"
                                                   FontFamily="{StaticResource IconFont}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold"
                                                   FontSize="11.5" Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty state -->
            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{DynamicResource AppBackground}"
                    Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="48"
                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource EmptyTitle}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <TextBlock Text="{DynamicResource EmptyHint}" Style="{StaticResource BodyTextStyle}"
                               Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Click="AddFiles_Click" Content="{DynamicResource AddFilesButton}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="AddFolder_Click" Margin="8,0,0,0"
                                Content="{DynamicResource AddFolderButton}" />
                    </StackPanel>

                    <TextBlock Text="{DynamicResource EmptySuggestions}" Style="{StaticResource PanelHeaderTextStyle}"
                               HorizontalAlignment="Center" Margin="0,22,0,8" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SuggestPreset_Click" Tag="Đánh số theo thứ tự"
                                Content="{DynamicResource SuggestNumbering}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SuggestPreset_Click" Tag="Dọn dẹp tên tệp"
                                Content="{DynamicResource SuggestTrim}" Margin="8,0,0,0" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Click="SuggestPreset_Click" Tag="Ảnh theo ngày chụp"
                                Content="{DynamicResource SuggestDate}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Thanh hành động dưới ================= -->
        <Border Grid.Row="3" Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Chip lọc trạng thái -->
                    <Border Background="{DynamicResource ChipBackground}" BorderBrush="{DynamicResource ChipBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,0">
                        <TextBlock Text="{Binding StatusSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                    </Border>

                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}" Margin="4,0,0,0" />

                    <!-- InfoBar thành công -->
                    <Border Background="{DynamicResource SuccessSoft}" BorderBrush="{DynamicResource Success}"
                            BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0"
                            Visibility="{Binding HasSuccessMessage, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SuccessMessage}" Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="6,0,10,0" />
                            <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource Undo}"
                                    Click="Undo_Click" Padding="6,2" />
                            <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource MenuHistory}"
                                    Click="History_Click" Padding="6,2" />
                            <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource MenuExportReport}"
                                    Click="ExportReport_Click" Padding="6,2" />
                        </StackPanel>
                    </Border>

                    <!-- Tiến trình -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding BusyText}" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="{DynamicResource Cancel}"
                                Click="CancelWork_Click" Padding="6,2" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Undo}" Click="Undo_Click"
                            Command="{Binding UndoCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="Undo last rename" />
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButtonStyle}" Click="Apply_Click"
                            Command="{Binding ApplyCommand}" MinWidth="180"
                            Content="{Binding ApplyButtonText}"
                            AutomationProperties.Name="Apply renaming" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
